# Qdrant: http(s) URL for a server, or "local:<path>" for embedded local mode (no Docker)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=anatomy_chunks
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu            # cpu | cuda | mps
EMBEDDING_BATCH_SIZE=16
LLM_PROVIDER=openai_compatible  # anthropic | openai_compatible
LLM_MODEL=
LLM_BASE_URL=                   # Ollama/vLLM için
LLM_API_KEY=
LLM_TIMEOUT_S=30
LLM_MAX_TOKENS=800
TOP_K=6
MIN_HITS=3
NEIGHBOR_DEPTH=1
MAX_NEIGHBORS=40
TIER1_BOOST=0.03
MAX_PER_SECTION=2
GROUP_MIN_DESCENDANTS=100       # bu kadar alt yapısı olan düğüm "bölge/sistem" sayılır (ancestors filtresi)
ANSWER_LANG=tr
CORS_ORIGINS=*
LOG_LEVEL=INFO
DATA_DIR=data
CONFIG_DIR=config
